generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id          String   @id
  tokenHash   String
  name        String?
  platform    String?
  status      String   @default("active")
  dailyLimit  Int      @default(20)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  downloads DownloadJob[]
  files     FileAsset[]
  editJobs  EditJob[]
  uploadedMedia UploadedMedia[]
}

/// Device-uploaded local source media (not shown in Home downloads list).
model UploadedMedia {
  id                  String   @id @default(uuid())
  deviceId            String
  kind                String   @default("video")
  originalFilename    String?
  mimeType            String?
  sizeBytes           BigInt
  storageKey          String
  durationSeconds     Int?
  width               Int?
  height              Int?
  thumbnailStorageKey String?
  /// MVP: ready | failed
  status              String   @default("ready")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([createdAt])
  @@index([deviceId, createdAt])
}

model InviteCode {
  id        String    @id @default(uuid())
  code      String    @unique
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Link {
  id          String   @id @default(uuid())
  url         String
  urlHash     String   @unique
  platform    String?
  title       String?
  thumbnail   String?
  durationSec Int?
  extractor   String?
  /// When true, analyze used HTML/JSON fallback (yt-dlp "Cannot parse data"); worker re-extracts CDN URL before download.
  facebookDirectFallback Boolean @default(false)
  createdAt   DateTime @default(now())

  downloads DownloadJob[]
}

model DownloadJob {
  id               String   @id @default(uuid())
  deviceId         String
  linkId           String
  status           String
  format           String?
  quality          String?
  /// Nullable = unknown progress (UI shows indeterminate). Set 0–100 when meaningful.
  progress         Int?
  /// queued | preparing | downloading | checking_compatibility | remuxing | normalizing_audio | full_transcoding | finalizing | done | failed
  processingStage  String?
  speedText        String?
  etaText          String?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  device Device      @relation(fields: [deviceId], references: [id])
  link   Link        @relation(fields: [linkId], references: [id])
  files  FileAsset[]
  events EventLog[]

  @@index([deviceId, status])
  @@index([deviceId, createdAt])
}

model FileAsset {
  id          String    @id @default(uuid())
  deviceId    String
  jobId       String
  type        String
  storageKey  String
  filename    String
  mimeType    String?
  sizeBytes   BigInt?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  device Device      @relation(fields: [deviceId], references: [id])
  job    DownloadJob @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model EventLog {
  id        String   @id @default(uuid())
  jobId     String?
  deviceId  String?
  level     String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  job DownloadJob? @relation(fields: [jobId], references: [id])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Post-download Quick Edit job (separate lifecycle from DownloadJob).
model EditJob {
  id                    String    @id @default(uuid())
  deviceId              String
  sourceDownloadJobId   String
  /// queued | running | done | failed
  status                String
  /// queued | validating_source | probing | processing | finalizing | done | failed
  stage                 String?
  progressPercent       Int?
  operationsJson        Json
  outputStorageKey      String?
  outputFilename        String?
  outputMimeType        String?
  outputSizeBytes       BigInt?
  errorCode             String?
  errorMessage          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  completedAt           DateTime?

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, status])
  @@index([deviceId, createdAt])
  @@index([deviceId, sourceDownloadJobId])
}
