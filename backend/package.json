{
  "name": "private-video-downloader-api",
  "version": "0.1.0",
  "private": true,
  "description": "Private multi-device video downloader backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "worker": "node dist/workers/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.8.2",
    "bullmq": "^5.52.2",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
