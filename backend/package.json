{
  "name": "private-video-downloader-api",
  "version": "0.1.0",
  "private": true,
  "description": "Private multi-device video downloader backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "worker": "node dist/workers/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/worker.ts",
    "diag:facebook": "tsx scripts/facebook-fallback-diagnostic.ts",
    "diag:alert": "tsx scripts/send-alert-test.ts",
    "diag:ass-captions": "tsx scripts/test-ass-caption-helpers.ts",
    "diag:caption-fonts": "tsx scripts/diag-caption-fonts.ts",
    "diag:runtime": "tsx scripts/diag-runtime.ts",
    "poc:caption-highlight": "tsx scripts/poc-caption-highlight-overlay.ts",
    "diag:caption-highlight": "tsx scripts/diag-caption-highlight.ts",
    "diag:audio-edit": "tsx scripts/diag-audio-edit.ts",
    "diag:ytdlp-classify": "tsx scripts/diag-ytdlp-classify.ts",
    "diag:analyze-tiktok-retry": "tsx scripts/diag-analyze-tiktok-retry.ts",
    "diag:download-tiktok-retry": "tsx scripts/diag-download-tiktok-retry.ts",
    "diag:tiktok-user-agent-args": "tsx scripts/diag-tiktok-user-agent-args.ts",
    "diag:youtube-matrix": "tsx scripts/diag-youtube-matrix.ts",
    "diag:youtube-pot": "tsx scripts/diag-youtube-pot.ts",
    "diag:youtube-proxy": "tsx scripts/diag-youtube-proxy.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "lint": "prisma generate && tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.0.0",
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "^6.8.2",
    "bullmq": "^5.52.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
