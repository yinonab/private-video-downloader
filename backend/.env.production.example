# Copy to `.env.production` on the server and replace every CHANGE_ME value.
# Must align DATABASE_URL password with POSTGRES_PASSWORD in compose `.env`.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://linkclip:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/linkclip
REDIS_URL=redis://redis:6379

STORAGE_DIR=/app/storage
COOKIES_FILE=/app/secrets/cookies/global.txt

AUTO_REGISTER_DEVICES=true
REQUIRE_INVITE_CODE=false

DEVICE_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_DEVICE_SECRET
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN

DOWNLOAD_CONCURRENCY=1
DEFAULT_DAILY_LIMIT=20
ANALYZE_DAILY_LIMIT=200

MEDIA_RETENTION_MINUTES=30
# Uploaded local sources live under devices/*/uploads/* — cleaned by UPLOAD_RETENTION_MINUTES in docker-compose cleanup (default 120).
UPLOAD_RETENTION_MINUTES=120

# Local video upload limits (multipart POST /uploads/videos)
MAX_LOCAL_VIDEO_UPLOAD_MB=175
MAX_LOCAL_VIDEO_UPLOAD_DURATION_SECONDS=420
