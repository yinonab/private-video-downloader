# Copy to `.env.production` on the server and replace every CHANGE_ME value.
# Must align DATABASE_URL password with POSTGRES_PASSWORD in compose `.env`.

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://linkclip:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/linkclip
REDIS_URL=redis://redis:6379

STORAGE_DIR=/app/storage
COOKIES_FILE=/app/secrets/cookies/global.txt

# Operational Slack alerts (sanitized payloads; in-memory cooldown — see alert.service.ts / operationalAlerts.ts)
ALERTS_ENABLED=false
ALERT_CHANNEL=slack
ALERT_COOLDOWN_MINUTES=30
ALERT_GENERIC_COOLDOWN_MINUTES=5
SLACK_WEBHOOK_URL=

AUTO_REGISTER_DEVICES=true
REQUIRE_INVITE_CODE=false

DEVICE_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_DEVICE_SECRET
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN

DOWNLOAD_CONCURRENCY=1
DEFAULT_DAILY_LIMIT=20
ANALYZE_DAILY_LIMIT=200

MEDIA_RETENTION_MINUTES=30
# Uploaded local sources live under devices/*/uploads/* — cleaned by UPLOAD_RETENTION_MINUTES in docker-compose cleanup (default 120).
UPLOAD_RETENTION_MINUTES=120

# Local video upload limits (multipart POST /uploads/videos)
MAX_LOCAL_VIDEO_UPLOAD_MB=175
MAX_LOCAL_VIDEO_UPLOAD_DURATION_SECONDS=420

# Captions V1 (edit `operations` type `captions`, burn-in via OpenAI Whisper). Omit `OPENAI_API_KEY` to reject caption jobs at API time.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# YouTube PO Token Provider spike (disabled by default — cookies-only behavior when false).
# Requires: pip plugin bgutil-ytdlp-pot-provider (in Docker image) + optional HTTP provider service.
# Start provider: docker compose -f docker-compose.prod.yml --profile pot up -d bgutil-pot
YTDLP_PO_TOKEN_ENABLED=false
YTDLP_PO_TOKEN_PROVIDER_URL=http://bgutil-pot:4416
YTDLP_PO_TOKEN_CLIENT=mweb
YTDLP_PO_TOKEN_TIMEOUT_MS=8000
YTDLP_PO_TOKEN_MODE=server
YTDLP_PO_TOKEN_CACHE_ENABLED=true
